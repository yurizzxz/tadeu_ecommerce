# Banco usado pela aplicação e pelo Prisma Migrate.
DATABASE_URL="postgresql://user:password@localhost:5432/devstore"

# Banco separado e descartável, usado pelos testes e pelo seed demonstrativo.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/devstore_test"

# Origem pública da aplicação, também usada nas URLs canônicas.
BETTER_AUTH_URL="http://localhost:3000"

# Substitua por um segredo aleatório longo; nunca compartilhe o valor real.
BETTER_AUTH_SECRET="substitua-por-um-segredo-aleatorio-longo"
