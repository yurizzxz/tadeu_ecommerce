# Copie este arquivo para .env e substitua os valores de exemplo.
# Banco de desenvolvimento usado pela aplicação e pelo Prisma Migrate.
DATABASE_URL="postgresql://user:password@localhost:5432/devstore"

# Banco separado e descartável para testes e seed demonstrativo.
# Deve ser diferente de DATABASE_URL e nunca apontar para produção.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/devstore_test"

# Origem da aplicação, também usada nas URLs canônicas.
# Em outro ambiente, use a origem real daquele ambiente.
BETTER_AUTH_URL="http://localhost:3000"

# Gere um segredo aleatório exclusivo para cada ambiente, por exemplo:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# O valor abaixo é apenas um marcador e não deve ser usado como segredo real.
BETTER_AUTH_SECRET="substitua-por-um-segredo-aleatorio-unico"
